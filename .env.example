# Copy to .env (gitignored) at the repo root and fill in. Used from C2 onwards.
# Same names as Project 2, so the same keys work for both projects.
# On Kaggle, add them under Add-ons -> Secrets instead (LLM calls run locally
# in this project, so Kaggle does not need them yet).

# Gemini / Gemma (extraction fallback, grader): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (generation, extraction): https://console.groq.com/keys
GROQ_API_KEY=
